#include <iostream>
using namespace std;
class Number
{   
    private:
    int x;

    public:
    Number(int a)
    {
        x = a;
    }
    Number operator+(Number obj)
    {
        Number temp(0);
        temp.x = x + obj.x;
        return temp;
    }
    void display()
    {
        cout << "Value = " << x << endl;
    }
};
int main()
{
    Number n1(10), n2(20), n3(0);

    n3 = n1 + n2;

    cout << "First number: ";
    n1.display();

    cout << "Second number: ";
    n2.display();

    cout << "Sum: ";
    n3.display();

    return 0;
}
